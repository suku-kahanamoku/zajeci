# PHP REST API (php-core)
PHP_API_BASE_URL=http://127.0.0.1/php/php-core/api
PHP_FILE_ROOT=/home/suku/Workspace/php/php-core

# Public frontend URL; its hostname is forwarded to php-core for tenant resolution.
FRONTEND_HOST=http://vinozezajeci.localhost:3000

# Must equal php-core INTERNAL_API_KEY. Server-only; never use NUXT_PUBLIC_*.
INTERNAL_API_KEY=replace-with-the-same-random-secret-as-php-core

# Generate a unique production value with: openssl rand -base64 48
NUXT_SESSION_PASSWORD=replace-with-a-random-secret-of-at-least-32-characters
